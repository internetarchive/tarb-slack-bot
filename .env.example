# Copy to .env and fill in. .env is git-ignored; never commit real tokens.

# Bot User OAuth Token from your Slack app's "OAuth & Permissions" page (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-token-here

# ID of #tarb-tickets (starts with C). Right-click the channel > View channel details; it's at the bottom.
SLACK_CHANNEL_ID=C0123456789

# Optional: the workspace ID (starts with T). If set, the bot refuses to run with a token from any other workspace.
SLACK_TEAM_ID=

# Wiki username -> Slack member ID, for pinging the maintainer when a follow-up arrives.
# Member ID: Slack profile > ⋮ (More) > Copy member ID. Unmapped maintainers are named, not pinged.
TARB_SLACK_USERS=Harej=U...,Cyberpower678=U...,GreenC=U...

# Wikimedia asks bots to identify themselves with a contact address
TARB_USER_AGENT=tarb-bot/1.0 (https://github.com/internetarchive/tarb-slack-bot; you@example.org)

# Optional overrides
# TARB_MAINTAINERS=Harej,Cyberpower678,GreenC
# TARB_REACTION=white_check_mark
# TARB_FOLLOWUP_REACTION=point_up
# TARB_POLL_INTERVAL=60
# TARB_DB_PATH=tarb_bot.sqlite3
